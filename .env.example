# Copy to .env. run.sh and the Python app/worker load the project-root file.
# Existing process environment variables take precedence. Restart after editing.
# DOCLING_PORT below is the Docker host port; run.sh uses port 8765.
DOCLING_PORT=18765
DOCLING_ALLOWED_HOSTS=localhost,127.0.0.1
DOCLING_ALLOWED_ORIGINS=

# Optional translation via Azure OpenAI (extraction requires no API key).
# DOCLING_TRANSLATION_PROVIDER=azure_openai
# DOCLING_AZURE_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/openai/v1/
# DOCLING_AZURE_DEPLOYMENT=YOUR-DEPLOYMENT
# AZURE_OPENAI_API_KEY=

# Optional Python Wiki batch (see docs/wiki-batch.md).
# Set these in the selected Wiki workspace's .env or the process environment.
# AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
# AZURE_OPENAI_LUNA_DEPLOYMENT=YOUR-DRAFT-DEPLOYMENT
# AZURE_OPENAI_SOL_DEPLOYMENT=YOUR-VERIFY-DEPLOYMENT

# Optional Codex translation / explanation. Never mount your whole .codex folder.
# OPENAI_API_KEY=

# OCR defaults to local. Select Azure Read in the upload UI to use the connection below.
# Azure Document Intelligence settings are separate from Azure OpenAI translation.
# DOCLING_AZURE_OCR_ENDPOINT=https://YOUR-RESOURCE.cognitiveservices.azure.com
# AZURE_DOCUMENT_INTELLIGENCE_API_KEY=
# Without a key, Azure VMs use managed identity. Only a user-assigned ID needs this:
# DOCLING_AZURE_OCR_CLIENT_ID=

# Optional writable locations (installed resources remain read-only)
# DOCLING_STATE_DIR=/path/to/docling-desk-state
# Data root contains content/, derived/, runtime/ (SQLite), and cache/ (thumbnails).
# Only content/ and optional derived/ are candidates for future Blob synchronization.
# Blob connection/synchronization is not implemented. See docs/content-storage.md.
# DOCLING_DATA_DIR=/path/to/docling-desk-data
# DOCLING_MODELS_DIR=/path/to/models
# Shared rendering tools; document thumbnails stay under DOCLING_DATA_DIR/cache/.
# DOCLING_CACHE_DIR=/path/to/cache
# DOCLING_ENV_FILE=/path/to/settings.env
