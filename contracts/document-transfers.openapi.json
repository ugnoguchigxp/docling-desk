                  "file",
                  "metadata"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  },
                  "metadata": {
                    "type": "string",
                    "description": "JSON encoded SourceMetadata",
                    "contentMediaType": "application/json",
                    "contentSchema": {
                      "$schema": "https://json-schema.org/draft/2020-12/schema",
                      "type": "object",
                      "properties": {
                        "title": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 256
                        },
                        "collection_id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128
                        },
                        "project_id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128
                        },
                        "region": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128
                        },
                        "source_kind": {
                          "default": "document",
                          "type": "string",
                          "enum": [
                            "document",
                            "wiki"
                          ]
                        },
                        "language": {
                          "default": "ja",
                          "type": "string",
                          "minLength": 2,
                          "maxLength": 16
                        },
                        "external_key": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 256
                        }
                      },
                      "required": [
