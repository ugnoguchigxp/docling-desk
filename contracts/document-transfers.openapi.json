                        "collection_id"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "ocr_provider": {
                    "type": "string",
                    "enum": [
                      "local",
                      "azure_read",
                      "disabled"
                    ]
                  },
                  "source_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "etag": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  }
                },
                "dependentRequired": {
                  "source_id": [
                    "etag"
                  ],
                  "etag": [
                    "source_id"
                  ]
                }
              }
            }
          }
        }
      }
    },
